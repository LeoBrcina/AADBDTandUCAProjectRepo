@model PicGramWebApp.Models.Photo

@{
    ViewData["Title"] = "Photo Details";
}

<h2>Photo Details</h2>

<div class="card">
    <div class="card-body">
        <img src="@Model.FilePath" class="img-fluid mb-3" alt="Photo" />

        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Author:</strong> @Model.User?.Email</p>
        <p><strong>Uploaded:</strong> @Model.UploadedAt.ToString("dd.MM.yyyy. HH:mm")</p>

        <a asp-controller="Photo" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-success">
            Download Original
        </a>

        <a asp-controller="Photo" asp-action="DownloadOptions" asp-route-id="@Model.Id" class="btn btn-primary">
            Download Processed
        </a>

        <a asp-controller="Photo" asp-action="Index" class="btn btn-secondary">
            Back to Browse
        </a>
    </div>
</div>