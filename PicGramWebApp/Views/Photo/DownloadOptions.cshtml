@model PicGramWebApp.Models.Photo

@{
    ViewData["Title"] = "Download Options";
}

<h2>Download Processed Photo</h2>

<div class="mb-4">
    <img src="@Model.FilePath" width="250" class="mb-3" />
    <p><strong>Description:</strong> @Model.Description</p>
</div>

<form asp-controller="Photo" asp-action="DownloadProcessed" method="get">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Width</label>
        <input type="number" name="width" class="form-control" placeholder="e.g. 300" />
    </div>

    <div class="mb-3">
        <label class="form-label">Height</label>
        <input type="number" name="height" class="form-control" placeholder="e.g. 300" />
    </div>

    <div class="mb-3">
        <label class="form-label">Format</label>
        <select name="format" class="form-select">
            <option value="jpg">JPG</option>
            <option value="png">PNG</option>
            <option value="bmp">BMP</option>
        </select>
    </div>
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="applySepia" value="true" id="applySepia" />
        <label class="form-check-label" for="applySepia">
            Apply sepia
        </label>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="applyBlur" value="true" id="applyBlur" />
        <label class="form-check-label" for="applyBlur">
            Apply blur
        </label>
    </div>

    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="applyGrayscale" value="true" id="applyGrayscale" />
        <label class="form-check-label" for="applyGrayscale">
            Apply grayscale
        </label>
    </div>

    <div class="mb-3">
        <label class="form-label">Sharpen amount</label>
        <input type="number" step="0.1" name="sharpenAmount" class="form-control" placeholder="e.g. 2" />
    </div>

    <div class="mb-3">
        <label class="form-label">Brightness</label>
        <input type="number" step="0.1" name="brightness" class="form-control" placeholder="1 = normal, e.g. 1.2" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contrast</label>
        <input type="number" step="0.1" name="contrast" class="form-control" placeholder="1 = normal, e.g. 1.2" />
    </div>

    <button type="submit" class="btn btn-primary">Download Processed</button>
    <a asp-controller="Photo" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back</a>
</form>