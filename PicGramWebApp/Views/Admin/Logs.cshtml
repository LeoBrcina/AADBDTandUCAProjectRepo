@model List<PicGramWebApp.Models.ActionLog>

@{
    ViewData["Title"] = "Action Logs";
}

<h2>Action Logs</h2>

@if (!Model.Any())
{
    <p>No logs found.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>User</th>
                <th>Action</th>
                <th>When</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@(log.User?.Email ?? "Anonymous")</td>
                    <td>@log.ActionType</td>
                    <td>@log.CreatedAt.ToString("dd.MM.yyyy. HH:mm:ss")</td>
                    <td>@log.Details</td>
                </tr>
            }
        </tbody>
    </table>
}