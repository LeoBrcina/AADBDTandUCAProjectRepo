@model PicGramWebApp.Models.Photo

@{
    ViewData["Title"] = "Edit Photo";
}

<h2>Edit Photo</h2>

<form asp-action="EditPhoto" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <img src="@Model.FilePath" width="250" class="mb-3" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <input type="text" name="description" value="@Model.Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Hashtags</label>
        <input type="text" name="hashtags" value="@ViewBag.Hashtags" class="form-control" placeholder="f1, ferrari, racing" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-controller="Admin" asp-action="Photos" class="btn btn-secondary">Back</a>
</form>