@model List<PicGramWebApp.Models.Photo>

@{
    ViewData["Title"] = "Manage Photos";
}

<h2>Manage Photos</h2>

@if (!Model.Any())
{
    <p>No photos found.</p>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>Preview</th>
                <th>Description</th>
                <th>Author</th>
                <th>Uploaded</th>
                <th>Hashtags</th>
                <th>Photo Id</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var photo in Model)
            {
                <tr>
                    <td>
                        <img src="@photo.FilePath" width="120" />
                    </td>
                    <td>@photo.Description</td>
                    <td>@photo.User?.Email</td>
                    <td>@photo.UploadedAt.ToString("dd.MM.yyyy. HH:mm")</td>
                    <td>
                        @if (photo.PhotoHashtags != null && photo.PhotoHashtags.Any())
                        {
                            @string.Join(", ", photo.PhotoHashtags.Select(ph => "#" + ph.Hashtag!.Name))
                        }
                    </td>
                    <td>@photo.Id</td>
                    <td>
                        <a asp-controller="Admin" asp-action="EditPhoto" asp-route-id="@photo.Id" class="btn btn-warning btn-sm mb-1">
                            Edit
                        </a>

                        <form asp-controller="Admin" asp-action="DeletePhoto" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@photo.Id" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this photo?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}